# Prabhim Technologies - Environment Configuration Example
# Copy this file to .env and fill in your values for local development.
# In production, configure these as server environment variables / container secrets.

# SMTP Mail Server Configuration (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
# IMPORTANT: For Gmail, use a 16-character App Password generated from:
# Google Account -> Security -> 2-Step Verification -> App Passwords
# (Never use your regular Gmail password)
MAIL_PASSWORD=
MAIL_FROM=
